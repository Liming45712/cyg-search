{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "畅易阁角色筛选",
  "version": "0.3.12",
  "identifier": "com.local.cygfinder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "畅易阁 · 角色筛选",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
