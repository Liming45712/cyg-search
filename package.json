{
  "name": "cyg-finder",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "tauri": "tauri",
    "bundle:mac": "tauri build --debug && codesign --force --deep --sign - src-tauri/target/debug/bundle/macos/畅易阁角色筛选.app && mkdir -p outputs && ditto src-tauri/target/debug/bundle/macos/畅易阁角色筛选.app outputs/畅易阁角色筛选.app",
    "bundle:windows": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.0.0",
    "element-plus": "2.11.8",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vue-tsc": "^3.3.14"
  }
}
